{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Chat conversation thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "isPinned": { "type": "boolean" },
        "messageCount": { "type": "integer" }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual message in a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "userId": { "type": "string" },
        "sender": { "type": "string", "enum": ["user", "assistant"] },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["sending", "sent", "error"] }
      },
      "required": ["id", "conversationId", "userId", "sender", "text", "timestamp"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "User scheduled reminder or task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "dueTimestamp": { "type": "integer" },
        "isCompleted": { "type": "boolean" },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "repeatOption": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "dueTimestamp", "isCompleted", "createdAt"]
    },
    "QuickNote": {
      "title": "QuickNote",
      "description": "User quick note",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "content", "createdAt"]
    },
    "MemoryItem": {
      "title": "MemoryItem",
      "description": "Saved memory preference or fact",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "key": { "type": "string" },
        "value": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "key", "value", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account document"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Chat conversations for user"
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a conversation"
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": "Reminder",
      "description": "Scheduled reminders for user"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "QuickNote",
      "description": "Quick notes saved by user"
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": "MemoryItem",
      "description": "Learned or user-saved memory facts"
    }
  }
}
