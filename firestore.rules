rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile validation
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             data.createdAt is timestamp;
    }

    // Conversation validation
    function isValidConversation(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             (!('isPinned' in data) || data.isPinned is bool) &&
             (!('messageCount' in data) || data.messageCount is int);
    }

    // Message validation
    function isValidMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.conversationId is string && data.conversationId.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.sender in ['user', 'assistant'] &&
             data.text is string && data.text.size() <= 20000 &&
             data.timestamp is timestamp &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000)) &&
             (!('status' in data) || data.status in ['sending', 'sent', 'error']);
    }

    // Reminder validation
    function isValidReminder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
             data.dueTimestamp is int &&
             data.isCompleted is bool &&
             data.createdAt is timestamp &&
             (!('priority' in data) || data.priority in ['LOW', 'MEDIUM', 'HIGH']) &&
             (!('repeatOption' in data) || (data.repeatOption is string && data.repeatOption.size() <= 50));
    }

    // Quick Note validation
    function isValidQuickNote(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             data.createdAt is timestamp &&
             (!('isPinned' in data) || data.isPinned is bool) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Memory Item validation
    function isValidMemory(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.key is string && data.key.size() > 0 && data.key.size() <= 100 &&
             data.value is string && data.value.size() > 0 && data.value.size() <= 1000 &&
             data.createdAt is timestamp &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt;

      allow delete: if isOwner(userId);

      match /conversations/{conversationId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         isValidConversation(incoming());

        allow update: if isOwner(userId) &&
                         isValidConversation(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt;

        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow get, list: if isOwner(userId);

          allow create: if isOwner(userId) &&
                           isValidId(messageId) &&
                           isValidMessage(incoming());

          allow update: if isOwner(userId) &&
                           isValidMessage(incoming()) &&
                           incoming().id == existing().id &&
                           incoming().userId == existing().userId &&
                           incoming().timestamp == existing().timestamp;

          allow delete: if isOwner(userId);
        }
      }

      match /reminders/{reminderId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(reminderId) &&
                         isValidReminder(incoming());

        allow update: if isOwner(userId) &&
                         isValidReminder(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId;

        allow delete: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(noteId) &&
                         isValidQuickNote(incoming());

        allow update: if isOwner(userId) &&
                         isValidQuickNote(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId;

        allow delete: if isOwner(userId);
      }

      match /memories/{memoryId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(memoryId) &&
                         isValidMemory(incoming());

        allow update: if isOwner(userId) &&
                         isValidMemory(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId;

        allow delete: if isOwner(userId);
      }
    }
  }
}
